{
    "name": "amidesfahani/filament-payment-manager",
    "description": "A Filament plugin to manage Shetabit Payment gateways",
    "type": "library",
    "keywords": ["filament", "payment", "shetabit", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "spatie/laravel-package-tools": "^1.92.7",
        "filament/filament": "^4.0",
        "shetabit/payment": "^6.0",
        "moneyphp/money": "^4.8",
        "illuminate/contracts": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^11.1"
    },
    "autoload": {
        "psr-4": {
            "AmidEsfahani\\FilamentPaymentManager\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmidEsfahani\\FilamentPaymentManager\\FilamentPaymentManagerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}